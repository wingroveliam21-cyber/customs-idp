# Client-side Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://idxlzebqfuomzxtqxrey.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
NEXT_PUBLIC_APP_URL=https://your-customs-idp-deployment.example.com

# Server-side Supabase configuration
SUPABASE_URL=https://idxlzebqfuomzxtqxrey.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Production app URL. For local testing use:
# APP_URL=http://localhost:3000
APP_URL=https://your-customs-idp-deployment.example.com

# Outlook OAuth callback. This MUST point to the callback endpoint, not the app root.
# Production:
OUTLOOK_REDIRECT_URI=https://your-customs-idp-deployment.example.com/api/outlook/callback
# Local testing:
# OUTLOOK_REDIRECT_URI=http://localhost:3000/api/outlook/callback
# Public webhook URL used by Microsoft Graph. For local testing, point this at the deployed webhook:
# OUTLOOK_WEBHOOK_URL=https://customs-idp.vercel.app/api/outlook/webhook
OUTLOOK_CLIENT_ID=your_microsoft_application_client_id
OUTLOOK_CLIENT_SECRET=your_microsoft_application_client_secret
OUTLOOK_TOKEN_ENCRYPTION_KEY=your_base64_encoded_32_byte_key

# Authenticates Vercel renewal and external queue-worker requests.
CRON_SECRET=change_this_to_a_long_random_secret

OPENAI_API_KEY=your_openai_api_key_here
IDP_AUTH_SECRET=change_this_to_a_long_random_secret
EMAIL_INGEST_SECRET=change_this_to_a_long_random_secret

# Resend inbound email webhook (https://resend.com/features/inbound)
RESEND_INBOUND_ADDRESS=test@fenauonto.resend.app
RESEND_API_KEY=your_resend_api_key
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_signing_secret
# Optional multi-tenant routing: {"inbound@example.resend.app":{"organisationId":"org-id"}}
RESEND_INBOUND_ROUTING_JSON={}
